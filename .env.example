# Banco de dados (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vancontrol

# Chave para assinar os tokens de login (OBRIGATÓRIA, mínimo 32 caracteres).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens permitidas para CORS em produção, separadas por vírgula.
# Em desenvolvimento deixe vazio (o Vite faz proxy de /api).
ALLOWED_ORIGINS=

# Chave da API Gemini (uso apenas no servidor; nunca exposta ao navegador)
GEMINI_API_KEY=

# ---- Mapas e rotas (Fase 1) ----
# Geocodificação (endereço -> coordenadas). Sem chave do Google, usa o OpenStreetMap (Nominatim),
# que é gratuito mas limitado a 1 consulta por segundo e exige identificação:
GEOCODER_USER_AGENT=VanControl/1.0 (seu-email@exemplo.com)
# Opcional: mais preciso no Brasil (pago por uso)
GOOGLE_MAPS_API_KEY=

# Cálculo do trajeto por ruas. O servidor público do OSRM é só para testes;
# em produção hospede o seu e aponte para ele. Use "estimativa" para não depender de serviço externo.
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
# Multiplica o tempo do OSRM (que considera vias livres) para refletir trânsito de horário escolar
ROUTING_FATOR_TRANSITO=1.3

# Tiles do mapa no navegador (opcional). Padrão: OpenStreetMap.
VITE_MAP_TILE_URL=

# ---- WhatsApp e portal dos pais (Fase 3) ----
# Nome que assina as mensagens enviadas aos pais
EMPRESA_NOME=VanControl
# Endereço público do sistema (usado no link do portal enviado aos pais)
APP_URL=http://localhost:3000
# Provedor: log (só mostra no console, para testes) | zapi | webhook (ex.: fluxo do n8n)
WHATSAPP_PROVIDER=log
# Z-API (painel da Z-API → sua instância)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Se usar WHATSAPP_PROVIDER=webhook: o sistema faz POST {telefone, mensagem, tipo, alunos} nesta URL
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# Segredo da URL que recebe as mensagens dos pais: /api/publico/whatsapp/<segredo>
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_WEBHOOK_SEGREDO=
# Avisar "a van chega em ~N min" quando faltar este tempo
AVISO_CHEGADA_MIN=5

# ---- Financeiro (Fase 4) ----
# Por padrão a cobrança é por Pix direto na chave da empresa (sem taxa; a baixa é feita no painel).
# A chave Pix, multa/juros, régua de cobrança e o modelo de contrato ficam em Financeiro → Configurações.
# Opcional: Asaas (boleto, cartão e Pix com baixa automática; cobra taxa por pagamento).
# Chave da API: painel do Asaas → Integrações → Chave da API
ASAAS_API_KEY=
# Token que você define no webhook do Asaas (Integrações → Webhooks), URL: <APP_URL>/api/publico/asaas
ASAAS_WEBHOOK_TOKEN=
# (raro) URL da API, se precisar sobrescrever o sandbox/produção escolhido no painel
ASAAS_URL=
# REGUA_DESLIGADA=1 desliga o envio automático diário das cobranças
REGUA_DESLIGADA=

# ---- Operação (Fase 5) ----
# Os limites dos alertas (velocidade, parada, desvio...) e o WhatsApp do gestor ficam em Operação → Alertas → Configurar.
# MONITOR_DESLIGADO=1 desliga a verificação automática de anomalias (a cada minuto)
MONITOR_DESLIGADO=

# ---- Multi-empresa, perfis e LGPD (Fase 0) ----
# Empresa principal (a primeira): usa o WhatsApp/Asaas do .env enquanto não salvar os próprios no painel.
EMPRESA_PRINCIPAL_ID=1
# RETENCAO_DESLIGADA=1 desliga a anonimização automática diária (LGPD)
RETENCAO_DESLIGADA=

# ---- Inteligência de rota (Fase 6) ----
# Fator de lentidão do trânsito sobre o mapa de ruas (OSRM) e multiplicador no horário de pico
# ROUTING_FATOR_TRANSITO=1.2
ROUTING_PICO_MULT=1.3
ROUTING_PICOS=06:30-08:30,11:30-13:30,17:00-19:00

# ---- Extras (Fase 7) ----
# IA no WhatsApp (Gemini): chave grátis em https://aistudio.google.com — sem chave, a IA fica desligada
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
